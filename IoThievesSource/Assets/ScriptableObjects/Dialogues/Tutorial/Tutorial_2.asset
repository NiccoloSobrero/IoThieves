  m_Script: {fileID: 11500000, guid: b2bec28576622e5469ff125d61c4e3a5, type: 3}
  m_Name: Tutorial_2
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "Hold it! Camera at twelve o\u2019clock. That thing almost caught you."
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "See the red area it\u2019s sweeping around? Stay out of that unless you
      want alarms blaring."
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "Alright, we\u2019ll need a distraction. Head over to that 3D printer in
      the corner."
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "Yeah, that chunky machine right there. Get close and I\u2019ll upload
      a blueprint for something noisy."
