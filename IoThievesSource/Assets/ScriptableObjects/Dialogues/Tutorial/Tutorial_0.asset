%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2bec28576622e5469ff125d61c4e3a5, type: 3}
  m_Name: Tutorial_0
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Alright, systems online...\nHELLOOOOOOOO CAN YOU HEAR ME?????
    tags: 
  - speakerName: ???
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: '. . . '
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Welcome to the world, my litle creation. How do you feel?\nAre you ready
      for a very incredible adventure???
    tags: 
  - speakerName: ???
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: . . .
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: 7ca5486df83ebce4681cd89b1a1d718c, type: 3}
    text: No words, uh? Why are you so silent? **Did I miss something?**
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: 4ab0fecf046fa7549b5e86ae6d70be77, type: 3}
    text: Oh, right! You're just a scrap of metal right now,\nI don't give you an
      AI yet. Let me try this one... Done! \nHow do you feel?
    tags: 
  - speakerName: Hatsune Miku
    icon: {fileID: 21300000, guid: f10cff0a88e161e439e2b7948dbfa623, type: 3}
    text: "Mikuday\u014D"
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: ad771f752afefa244b5c465f7173d61b, type: 3}
    text: HATSUNE MIKU!?!?
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: fe04ed84c31596644b94bfaa49ee0e33, type: 3}
    text: Nope, wrong AI! Let me try this one instead...
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: Woah! Who are you? Where am I? <b>WHO</b> am I? What's happening??
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Once again. Welcome to the world, my little creation!\nYou are my <i>Personal
      Infiltration Prototype</i> robot, aka PIP. It fits you, doesn't it?
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: Cut it, where am I? Who are you?
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Right, I think I should give you some context.\nI'm an <i><b>Hacker</b></i>,
      I built you remotely by hacking the super 3D printer behind you.
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: 'You are in a basement somewhere in the city. I need your help to get my
      revenge on my boss. Can you help me, pleeeease? '
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: Ok, why not :\ \nDo I really have a choice?
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: 5ff570c2964bbe748bf7be2ffcc8bd95, type: 3}
    text: Absolutely... not :) eheheh...
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "Now, you need to get out from there.\\nLet\u2019s see if you can follow
      basic commands."
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: See that marked keypad up ahead?
    tags: 02000000
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Move towards it. It's the only way to exit. \nUse < <b>W,A,S,D</b> > to
      move.
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: What the hell is "W A S D" ??
    tags: 03000000
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Don't worry about it\nOh wait! I almost forgot! This garage is really quiet,
      so here's some music.
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: I've uploaded something nice, you can play whatever you want.\nEnjoy! :)
    tags: 03000000
