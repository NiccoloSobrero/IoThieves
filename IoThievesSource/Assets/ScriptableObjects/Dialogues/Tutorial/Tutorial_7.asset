  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Ok. First of all we need to hack this computer and log in.
  - speakerName: Hacker
