  m_Script: {fileID: 11500000, guid: b2bec28576622e5469ff125d61c4e3a5, type: 3}
  m_Name: BH_2_OnArriveAtTheDoor
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: 4ab0fecf046fa7549b5e86ae6d70be77, type: 3}
    text: Well... the door is locked (of course)
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: We need to find another way to open the door.
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: 'Another crowbar? >: )'
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Naaah, this time we can use the key (like everyone else...)
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: I think I saw it in the living room, near the guy watching the tv.
    tags: 
