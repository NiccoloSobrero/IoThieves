  m_Script: {fileID: 11500000, guid: b2bec28576622e5469ff125d61c4e3a5, type: 3}
  m_Name: Intro
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: ad771f752afefa244b5c465f7173d61b, type: 3}
    text: Wow, so this is my ex-Boss' house! It's HUGE!
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: Something tells me that I'm gonna give you a free tour inside it :/
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: 5ff570c2964bbe748bf7be2ffcc8bd95, type: 3}
    text: Sooooo right, buddy! eheheh
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: 'We need to find something that could incriminate that man. '
    tags: 
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: Maybe we can check inside his personal PC in his room.
    tags: 03000000
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: It's all the way above. It's a bit distant, and the house is full of people.
      But nothing is impossible, my friend!
    tags: 
  - speakerName: PIP
    icon: {fileID: 21300000, guid: 3e4ff024cd09fad41a6f1af4bf8b77be, type: 3}
    text: '**inspires** Well, I''m cooked.'
    tags: 03000000
