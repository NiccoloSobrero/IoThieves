  m_Script: {fileID: 11500000, guid: b2bec28576622e5469ff125d61c4e3a5, type: 3}
  m_Name: Tutorial_0
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "Alright PIP, systems online. Welcome to the world\u2014now let\u2019s
      see if you can follow basic commands."
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: 'I built you for one job: get in, grab stuff, and get out. Simple enough,
      right?'
  - speakerName: Hacker
    icon: {fileID: 21300000, guid: c4cb55bb1b421e94e9b8af299ed69aa8, type: 3}
    text: "See that marker up ahead? Move toward it. Consider this your first baby
      step\u2026 well, robot step."
