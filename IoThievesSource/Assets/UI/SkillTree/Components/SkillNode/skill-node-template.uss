.skill-node {
    width: 180px;
    height: 160px;
    border-radius: 100%;
    /*padding: 8px;*/
    align-items: center;
    justify-content: space-between;
    /*background-color: rgba(0, 0, 0, 0.45);*/
    display: flex;
    flex-direction: column;
    /*transition: background-color 0.2s ease-in-out;*/
    margin: 20px;
}

.skill-node:hover {
    background-color: rgba(0,0,0,0.6);
}

.skill-icon {
    width: 64px;
    height: 64px;
    margin-top: 6px;
    margin-bottom: 4px;
    align-self: center;
}

.skill-name {
    font-size: 14px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-cost {
    font-size: 12px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.skill-buy {
    width: 100%;
    height: 28px;
    border-radius: 10px;
}

.skill-node.unlocked {
    background-color: rgba(0, 128, 0, 0.4);
}

.skill-node.locked {
    background-color: rgba(128, 0, 0, 0.4);
}

.skill-button {
    width: 100%;
    height: 100%;
    border-radius: 100%;
    border-width: 2px;
}

.skill-button:hover {
    border-radius: 100%;
    border-width: 2px;
}

.skill-icon-img {
    width: 100%;
    height: 100%;
}