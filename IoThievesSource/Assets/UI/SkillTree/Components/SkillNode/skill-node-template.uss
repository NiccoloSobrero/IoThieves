/* change this class if you need to style the position of the skill nodes */
.skill-node {
    width: 180px;
    height: 160px;
    border-radius: 100%;
    align-items: center;
    justify-content: space-between;
    display: flex;
    flex-direction: column;
    margin: 40px 40px 80px 80px;
}

.skill-icon {
    width: 100%;
    height: 100%;
}

.skill-name {
    font-size: 24px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-cost {
    font-size: 24px;
    -unity-text-align: middle-center;
}

.skill-buy {
    width: 100%;
    height: 100%;
    border-radius: 100%;
    border-width: 2px;
}

.skill-buy:hover {
    border-radius: 100%;
    border-width: 2px;
    border-color: black;
}

.skill-node.unlocked {
    background-color: rgba(0, 128, 0, 0.4);
}

.skill-node.locked {
    background-color: rgba(128, 0, 0, 0.4);
}