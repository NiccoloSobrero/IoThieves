.skill-tree {
    align-self: center;
    align-content: center;
    flex-wrap: wrap;
    margin-top: 5%;
    padding-left: 40px;
    padding-right: 40px;
    /*padding-top: 40px;*/
    height: 80%;
    width: 80%;
    flex-direction: row;
    justify-content: space-evenly;
    background-color: lightgrey;
    border-radius: 6%;
    border-width: 8px;
    border-color: white;
}

