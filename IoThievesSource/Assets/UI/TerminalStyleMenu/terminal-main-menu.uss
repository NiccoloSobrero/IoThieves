.terminal-main-menu {
    flex-direction: column;
    background-color: #0b0f14;
    padding: 8px;
    width: 100%;
    height: 100%;
    /*border-color: white;*/
    /*border-width: 2px;*/
}

.terminal-output {
    flex-grow: 1;
    font-size: 24px;
    /*border-color: red;*/
    /*border-width: 2px;*/
}

.input-line {
    flex-direction: row;
    align-items: center;
    /*border-color: cyan;*/
    /*border-width: 2px;*/
}

.prompt-header {
    color: #33ff33;
    margin-right: 6px;
    font-size: 24px;
    -unity-font: url("../../Fonts/JetBrainsMono-VariableFont_wght.ttf");
    /*border-color: lime;*/
    /*border-width: 2px;*/
}

.input-container {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    /*border-color: yellow;*/
    /*border-width: 2px;*/
    height: 100%;
}

.input-text {
    -unity-font: url("../../Fonts/JetBrainsMono-VariableFont_wght.ttf");
    font-size: 24px;
    color: #33ff33;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin-top: 8px;
    flex-grow: 1;
    /*border-color: red;*/
    /*border-width: 2px;*/
}

.caret {
    /*border-color: white;*/
    /*border-width: 2px;*/
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 24px;
    margin-top: 10px;
    background-color: #33ff33;
}


