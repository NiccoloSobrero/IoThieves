    <ui:VisualElement name="gameOverMenuContainer" class="menu-container game-over-menu-container">
        <ui:Label name="title" text="IoThieves" class="menu-title" />
        <ui:VisualElement name="gameOverMenuButtonsContainer" class="game-over-menu-buttons-container">
            <ui:Button name="restartButton" text="Restart" class="menu-button game-over-menu-button" />
