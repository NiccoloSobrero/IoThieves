<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/EndLevelMenu/end-level-menu.uss?fileID=7433441132597879392&amp;guid=d3c787a6d4fa35345b21a8b3851e668e&amp;type=3#end-level-menu" />
    <Style src="project://database/Assets/UI/Menu/menu-style.uss?fileID=7433441132597879392&amp;guid=8baf226fee4253342832e9861d4f70e9&amp;type=3#menu-style" />
    <ui:VisualElement name="endLevelMenuContainer" class="menu-container end-level-menu-container" >
        <ui:Label name="endLevelTitle" text="Level Completed" class="menu-title" />
        <ui:VisualElement name="endLevelMenuButtonsContainer" class="end-level-menu-buttons-container" >
            <!-- this contains the buttons -->
            <ui:Button name="playButton" class="end-level-menu-button" >
                <ui:VisualElement name="buttonTitleContainer" class="button-title-container" >
                    <ui:Label name="endLevelTitle" text="Documento 1" class="button-title" />
                </ui:VisualElement>
                <ui:VisualElement name="buttonDescriptionContainer" class="button-description-container" >
                    <ui:Label name="endLevelTitle" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." class="button-description" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="saveButton" text="Save" class="end-level-menu-button" />
            <ui:Button name="optionsButton" text="Options" class="end-level-menu-button" />
            <ui:Button name="quitButton" text="Quit" class="end-level-menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
