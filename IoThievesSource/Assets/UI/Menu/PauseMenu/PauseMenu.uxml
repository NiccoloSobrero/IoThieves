<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/PauseMenu/pause-menu.uss?fileID=7433441132597879392&amp;guid=34923a44a6eadca4ab3e89a6e8720725&amp;type=3#pause-menu" />
    <Style src="project://database/Assets/UI/Menu/menu-style.uss?fileID=7433441132597879392&amp;guid=8baf226fee4253342832e9861d4f70e9&amp;type=3#menu-style" />
    <ui:VisualElement name="pauseMenuContainer" class="menu-container pause-menu-container">
        <ui:Label name="title" text="IoThieves" class="menu-title" />
        <ui:VisualElement name="pauseMenuButtonsContainer" class="pause-menu-buttons-container">
            <ui:Button name="playButton" text="Play" class="menu-button pause-menu-button" />
            <ui:Button name="saveButton" text="Save" class="menu-button pause-menu-button" />
            <ui:Button name="optionsButton" text="Options" class="menu-button pause-menu-button" />
            <ui:Button name="quitButton" text="Quit" class="menu-button pause-menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
