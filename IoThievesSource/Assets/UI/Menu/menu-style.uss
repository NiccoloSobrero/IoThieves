:root {
    justify-content: center;
    /*-unity-font: url("/Assets/Fonts/VT323-Regular SDF.asset");*/
    /*-unity-font-definition: unset;*/
    -unity-font-definition: initial;
    -unity-font: url(../../Fonts/VT323-Regular.ttf);
}

.menu-container {
    align-self: center;
    border-color: white;
    border-radius: 16px;
    border-width: 4px;
}

.menu-title {
    align-self: center;
    font-size: 64px;
    -unity-font-style: bold;
    margin-top: 2%;
    height: 10%;
}

.menu-button {
    background-color: rgba(255, 255, 255, 0);
    -unity-font-style: bold;
    font-size: 48px;
    transition: 0.25s all;
}

.menu-button:hover {
    border-color: white;
    border-radius: 16px;
    border-width: 4px;
    font-size: 30px;
    scale: 1.1;
    rotate: 2deg;
}