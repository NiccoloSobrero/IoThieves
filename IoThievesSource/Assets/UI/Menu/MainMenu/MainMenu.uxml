<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/MainMenu/main-menu.uss?fileID=7433441132597879392&amp;guid=afb22e68959ee0b41a60ebff6e9459e5&amp;type=3#main-menu" />
    <ui:VisualElement name="mainMenuContainer" class="main-menu-container">
        <ui:Label name="title" class="main-menu-title" text="IoThieves"/>
        <ui:Image name="mainMenuImage" class="main-menu-image" />
        <ui:VisualElement name="mainMenuButtonsContainer" class="main-menu-buttons-container">
