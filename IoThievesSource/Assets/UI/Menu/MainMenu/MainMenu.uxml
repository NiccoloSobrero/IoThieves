<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/MainMenu/main-menu.uss?fileID=7433441132597879392&amp;guid=afb22e68959ee0b41a60ebff6e9459e5&amp;type=3#main-menu" />
    <Style src="project://database/Assets/UI/Menu/menu-style.uss?fileID=7433441132597879392&amp;guid=8baf226fee4253342832e9861d4f70e9&amp;type=3#menu-style" />
    <ui:VisualElement name="mainMenuContainer" class="menu-container main-menu-container">
        <ui:Label name="title" text="IoThieves" class="menu-title" />
        <ui:Image name="mainMenuImage" class="main-menu-image" />
        <ui:VisualElement name="mainMenuButtonsContainer" class="main-menu-buttons-container">
            <ui:Button name="playButton" text="Play" class="menu-button main-menu-button" />
            <ui:Button name="saveButton" text="Save" class="menu-button main-menu-button" />
            <ui:Button name="optionsButton" text="Options" class="menu-button main-menu-button" />
            <ui:Button name="quitButton" text="Quit" class="menu-button main-menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
