:root {
    justify-content: center;
}

.main-menu-container {
    align-self: center;
    width: 100%;
    height: 100%;
    background-color: grey;
    border-color: white;
    border-radius: 16px;
    border-width: 4px;
}

.main-menu-title {
    /*border-color: red;*/
    /*border-radius: 16px;*/
    /*border-width: 4px;*/
    align-self: center;
    font-size: 48px;
    -unity-font-style: bold;
    margin-top: 2%;
    height: 10%;
}

.main-menu-image {
    /*border-color: white;*/
    /*border-radius: 16px;*/
    /*border-width: 4px;*/
    height: 80%;
}

.main-menu-buttons-container {
    /*border-color: white;*/
    /*border-radius: 16px;*/
    /*border-width: 4px;*/
    height: 10%;
    width: 100%;
    flex-direction: row;
    justify-content: space-around;
}

.main-menu-button {
    align-self: center;
    height: 90%;
    width: 20%;
    background-color: rgba(255, 255, 255, 0);
    -unity-font-style: bold;
    font-size: 24px;
    transition: 0.25s all;
}

.main-menu-button:hover {
    border-color: white;
    border-radius: 16px;
    border-width: 4px;
    font-size: 30px;
    scale: 1.1;
    rotate: 2deg;
}