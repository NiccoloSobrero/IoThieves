.end-level-menu-buttons-container {
    align-self: center;
    justify-content: space-evenly;
    align-items: center;
    height: 80%;
    width: 100%;
}

.end-level-menu-button {
    height: 60%;
    width: 20%;
    border-radius: 12px;
    border-color: black;
    border-width: 4px;
}

.button-title-container {
    height: 20%;
    width: 100%;
    justify-content: center;
}

.button-description-container {
    height: 80%;
    width: 100%;
    justify-content: center;
}

.button-title {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    /*align-self: center;*/
    font-size: 24px;
    -unity-font-style: bold;
}

.button-description {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    /*align-self: center;*/
    /*align-items: center;*/
    /*justify-content: center;*/
    font-size: 18px;
    -unity-font-style: initial;
    white-space: normal;
    /*flex-wrap: wrap;*/
}