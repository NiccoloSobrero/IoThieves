.card-container {
    width: 400px;
    height: 300px;
    flex-grow: 1;
    /*flex-shrink: 0;*/
    margin: 12px;

    align-items: center;
    justify-content: center;
}

.card-button {
    height: 60%;
    max-width: 60%;
    border-radius: 12px;
    border-color: black;
    border-width: 4px;
}

.card-title-container {
    height: 20%;
    width: 100%;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: black;
}

.card-title {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    font-size: 24px;
    -unity-font-style: bold;
}

.card-description-container {
    height: 80%;
    width: 100%;
    justify-content: center;
}

.card-description {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    font-size: 24px;
    -unity-font-style: initial;
    white-space: normal;
}