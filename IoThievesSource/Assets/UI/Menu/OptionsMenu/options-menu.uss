.options-menu-container {
    width: 40%;
    height: 80%;
    background-color: rgba(128, 128, 128, 1);
}

.title-container {
    height: 10%;
    justify-content: center;
    align-self: center;
}

.options-title {
    font-size: 52px;
    -unity-font-style: bold;
}

.options-container {
    height: 75%;
    justify-content: space-evenly;
}

.sliders-container {
    height: 30%;
}

.slider-container {
    width: 100%;
    align-items: center;
}

.label {
    width: 10%;
    font-size: 36px;
    -unity-text-align: middle-center;
}

.action-slider {
    width: 80%;
}

.unity-base-slider__dragger {
    width: 4%;
    border-radius: 100%;
}


.actions-container {
    height: 70%;
    width: 100%;
    justify-content: space-evenly;
}

.action-container {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
    border-width: 2px;
    border-color: red;
    /*align-self: flex-start;*/
}

.action-label {
    align-items: flex-start;
    border-color: blue;
    border-width: 2px;
    
}

.rebind-button {
    align-self: center;
    height: 80%;
    width: 15%;
    border-color: green;
    border-width: 2px;
    font-size: 52px;
}

.action-dropdown {
    width: 40%;
    font-size: 36px;
}

.buttons-container {
    height: 15%;
    flex-direction: row;
    width: 100%;
    justify-content: space-evenly;
    align-items: center;
}

.options-button {
    width: 30%;
    height: 50%;
}