.options-menu-container {
    width: 40%;
    height: 60%;
    background-color: rgba(128, 128, 128, 1);
}

.options-top-elements-container {
    height: 80%;
    justify-content: space-around;
}

.options-title {
    align-self: center;
    font-size: 64px;
    -unity-font-style: bold;
    height: 10%;
}

.options-buttons-container {
    justify-content: center;
}

.options-bottom-elements-container {
    flex-direction: row;
    height: 20%;
    width: 100%;
    justify-content: space-between;
    align-items: center;
}

.options-button {
    margin-left: 5%;
    margin-right: 5%;
    height: 60%;
    width: 30%;
}
