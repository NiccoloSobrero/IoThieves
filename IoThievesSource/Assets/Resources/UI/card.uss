.card-container {
    flex-grow: 1;
    flex-basis: 0;
    /*border-width: 2px;*/
    /*border-color: red;*/
    align-self: stretch;
    /*justify-content: space-evenly;*/
    align-items: center;
    margin-top: 20%;
    height: 80%;
    
    /*width: 100%;*/
    /*height: 80%;*/
    /*width: 100%;*/
}

.card-button {
    height: 60%;
    /*width: 60%;*/
    max-width: 60%;
    border-radius: 12px;
    border-color: black;
    border-width: 4px;
}

.card-title-container {
    height: 20%;
    width: 100%;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: black;
}

.card-title {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    /*align-self: center;*/
    font-size: 24px;
    -unity-font-style: bold;
}

.card-description-container {
    height: 80%;
    width: 100%;
    justify-content: center;
}

.card-description {
    -unity-font-definition: initial;
    -unity-font: url(../../../Fonts/VT323-Regular.ttf);
    /*align-self: center;*/
    /*align-items: center;*/
    /*justify-content: center;*/
    font-size: 24px;
    -unity-font-style: initial;
    white-space: normal;
    /*-unity-text-align: middle-center;*/
    /*flex-wrap: wrap;*/
}